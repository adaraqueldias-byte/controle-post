# =====================================================================
# Copie este arquivo para ".env" e preencha com as suas credenciais.
# NUNCA suba o arquivo .env para o Git (ele já está no .gitignore).
# =====================================================================

# --- Mercado Livre -------------------------------------------------
# A busca pública não exige credenciais. Se você tiver conta de
# afiliado / programa de parceiros, coloque a tag aqui para gerar
# links já com o seu identificador.
ML_AFFILIATE_TAG=

# --- Shopee Afiliados (Open API) -----------------------------------
# Gere em: https://affiliate.shopee.com.br  ->  Painel do desenvolvedor
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# --- Telegram (módulo Postador) ------------------------------------
# Crie um bot com o @BotFather e cole o token aqui.
TELEGRAM_BOT_TOKEN=
# ID do canal/grupo onde o robô vai postar (ex.: -1001234567890 ou @seucanal).
TELEGRAM_CHAT_ID=
# Máximo de produtos postados por rodada e intervalo entre posts (segundos).
MAX_POSTS_POR_RODADA=5
INTERVALO_POSTS=3

# --- Configurações gerais ------------------------------------------
# Palavras-chave que o robô vai minerar, separadas por vírgula.
PALAVRAS_CHAVE=fone de ouvido,smartwatch,luminária led,organizador de cozinha

# Quantos produtos buscar por palavra-chave em cada fonte.
LIMITE_POR_BUSCA=20

# Horário da mineração diária (formato 24h HH:MM).
HORARIO_DIARIO=08:00
